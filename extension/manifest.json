{
  "manifest_version": 3,
  "name": "MFA AutoFill",
  "version": "1.3.6",
  "description": "自动填充 MFA 验证码: 邮箱验证码(经本地 mfa-code-fetcher) + TOTP 动态口令(纯本地计算)。按用户配置的域名动态注入, 无任何预置域名",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8642/*",
    "http://localhost:8642/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MFA 验证码"
  }
}
